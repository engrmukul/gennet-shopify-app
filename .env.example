# Shopify Partner app credentials (from partners.shopify.com or the Dev
# Dashboard). Never commit real values.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-url.example.com
SCOPES=read_orders

# PostgreSQL connection string for Prisma (sessions + app data).
DATABASE_URL=postgresql://user:password@localhost:5432/gennet_shopify_sms

# 32-byte (64 hex char) key used for AES-256-GCM encryption of per-shop
# Gennet API tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates all previously encrypted Gennet tokens —
# merchants would need to re-enter their token.
APP_ENCRYPTION_KEY=

# Optional: default Gennet API base URL merchants can override per-shop.
GENNET_DEFAULT_API_BASE_URL=https://isms.gennet.com.bd

NODE_ENV=development
PORT=3000
